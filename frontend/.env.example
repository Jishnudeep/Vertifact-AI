# Base URL of the VeriFact backend API.
#
# Empty (the default) = same-origin: the app calls /api/... on the host that
# serves it. Recommended for production builds, where the frontend and the
# backend sit behind the same origin.
#
# Only for local dev against a separate backend, set it explicitly, e.g.
#   VITE_API_BASE_URL=http://localhost:8000
#
# Never put secrets here: every VITE_* value is bundled into the client.
VITE_API_BASE_URL=
