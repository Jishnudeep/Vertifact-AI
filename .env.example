# ─────────────────────────────────────────────────────────────
# VeriFact AI — backend environment template
# Copy to `.env` (never commit the real .env) and fill in your keys:
#     cp .env.example .env
# config.py also finds `.env` in backend/ and backend/app/. Keys load server-side
# only (Pydantic Settings); nothing here is ever sent to the frontend.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Postgres + pgvector) ──
# Dashboard → Project Settings → API. Apply backend/app/db/migrations/*.sql by hand first.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISH_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key

# ── Gemini (Google AI Studio, free tier) ──
# One key serves every worker agent and the grounded-search calls. Not Vertex AI.
GEMINI_API_KEY=your-gemini-api-key

# ── Fact-check lookup ──
# Google Cloud Console → enable "Fact Check Tools API" → create an API key (free).
GOOGLE_FACTCHECK_API_KEY=your-google-fact-check-api-key

# ── Optional overrides (defaults shown; the source of truth is backend/app/config.py) ──
# Models are config, never hardcoded in agent logic.
# MODEL_ID=gemini-3.1-flash-lite
# SEARCH_MODEL_ID=gemini-3.1-flash-lite
# Thinking level is sent only to Gemini 3 models. Allowed: MINIMAL, LOW, MEDIUM, HIGH.
# FACTCHECK_THINKING_LEVEL=LOW
# CROSSREF_THINKING_LEVEL=LOW
# GROUNDED_SEARCH_THINKING_LEVEL=MINIMAL
# Model-turn caps per worker agent; exceeding one degrades that agent, never the request.
# FACTCHECK_MAX_TURNS=5
# CROSSREF_MAX_TURNS=4
# Embedding dimension: 384 = all-MiniLM-L6-v2 (dev), 1024 = BAAI/bge-m3 (prod).
# Must match the pgvector column dimension in the database schema.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384
# Local NLI cross-encoder for source stance and cache equivalence.
# NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
# NLI_MAX_LENGTH=256
# Linguistic agent: also ask the LLM for a sensationalism rating (heuristics only when false).
# ENABLE_LLM_SENSATIONALISM=false
# Model for the DeepEval judge in eval/ (the runner refuses to run when unset).
# EVAL_JUDGE_MODEL=

# ── Semantic cache TTL (hours) ──
# CACHE_TTL_FACT_CHECKED_HOURS=720
# CACHE_TTL_DEFAULT_HOURS=24

# ── Latency and spend guards ──
# Backstop for one worker agent (all its LLM turns and tool calls), in seconds.
# AGENT_TIMEOUT_S=30
# Per /api/verify request; it only bounds the wait for the persistence write.
# REQUEST_DEADLINE_S=35
# Daily ceilings (UTC day, per process). 0 disables a guard. eval/run_eval.py sets both to 0.
# The free Gemini key allows about 500 requests/day; a cold claim costs about 8.
# SEARCH_DAILY_CALL_BUDGET=150
# LLM_DAILY_CALL_BUDGET=900

# ── Deployment ──
# Allowed frontend origins (JSON list). Restrict to the real frontend domain in production.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Reverse proxies in front of the API that append to X-Forwarded-For.
# MUST be set when deployed: 0 = local dev, 1 = one platform proxy.
# With 0 behind a proxy, every user shares the proxy's rate-limit bucket.
# TRUSTED_PROXY_HOPS=0
# Claims and results older than this are deleted by purge_old_claims (migration 05).
# RETENTION_DAYS=90
