# ─────────────────────────────────────────────────────────────
# VeriFact AI — environment template
# Copy to `.env` (never commit the real .env) and fill in your keys.
# Loaded server-side via backend/app/config.py (Pydantic Settings).
# ─────────────────────────────────────────────────────────────

# ── Supabase (Postgres + pgvector) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISH_KEY=your-supabase-anon-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-secret-key

# ── LLM inference (dev: Groq, free tier) ──
GROQ_API_KEY=your-groq-api-key

# ── Search & fact-checking ──
# Google Fact Check Tools API is FREE (API key from Google Cloud Console).
GOOGLE_FACTCHECK_API_KEY=your-google-fact-check-api-key
TAVILY_API_KEY=your-tavily-api-key

# ── Optional overrides (defaults shown) ──
# Model is swapped via config, never hardcoded in agent logic.
# MODEL_ID=groq/openai/gpt-oss-120b
# Embedding dimension: 384 = all-MiniLM-L6-v2 (dev), 1024 = BAAI/bge-m3 (prod).
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384
# Linguistic agent: also ask the LLM for a sensationalism rating (heuristics only when false).
# ENABLE_LLM_SENSATIONALISM=false
# Local NLI cross-encoder for source stance and cache equivalence.
# NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small
# NLI_MAX_LENGTH=256

# ── Semantic cache TTL (hours) ──
# CACHE_TTL_FACT_CHECKED_HOURS=720
# CACHE_TTL_DEFAULT_HOURS=24

# ── Latency and spend guards ──
# Total wall-clock budget per /api/verify request, in seconds.
# REQUEST_DEADLINE_S=9.5
# Daily ceilings (UTC day, per process). 0 disables a guard. eval/run_eval.py sets both to 0.
# TAVILY_DAILY_CREDIT_BUDGET=30
# LLM_DAILY_CALL_BUDGET=900

# ── Deployment ──
# Allowed frontend origins (JSON list). Restrict to the real frontend domain in production.
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Reverse proxies in front of the API that append to X-Forwarded-For.
# MUST be set when deployed: 0 = local dev, 1 = one platform proxy (Render/Railway/Fly).
# With 0 behind a proxy, every user shares the proxy's rate-limit bucket.
# TRUSTED_PROXY_HOPS=0
# Claims and results older than this are deleted by purge_old_claims (migration 05).
# RETENTION_DAYS=90
